+}
+bool journal_write(const Journal& value) {
+    nvs_handle_t h; if(nvs_open("private_ota",NVS_READWRITE,&h)!=ESP_OK) return false;
+    bool ok=nvs_set_blob(h,"journal",&value,sizeof(value))==ESP_OK && nvs_commit(h)==ESP_OK;
