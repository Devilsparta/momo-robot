+bool journal_read(Journal& out) {
+    nvs_handle_t h;
+    const auto opened=nvs_open("private_ota",NVS_READONLY,&h);
+    if(opened==ESP_ERR_NVS_NOT_FOUND) return true;
+    if(opened!=ESP_OK) return false;
