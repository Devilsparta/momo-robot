+#include "avatar_audio.h"
+#include "audio_owner.h"
+#include <audio_codec.h>
+#include <board.h>
+#include <esp_opus_enc.h>
+#include <esp_opus_dec.h>
+#include <esp_ae_rate_cvt.h>
+#include <esp_pthread.h>
+#include <esp_log.h>
+#include <condition_variable>
+#include <deque>
+#include <thread>
